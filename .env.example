# Copy to .env and fill in. Never commit real values.
# Supabase (free plan): Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
# Server-side only (API and worker). Bypasses row-level security: keep secret.
SUPABASE_SERVICE_ROLE_KEY=

# Claude API (pay as you go): console.anthropic.com
ANTHROPIC_API_KEY=

# Jira Cloud OAuth 2.0 (3LO) app: developer.atlassian.com/console/myapps
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=

# Microsoft Entra ID app for Teams transcripts (Graph): entra.microsoft.com
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# API: public URLs and a random secret that signs the Jira sign-in round trip.
# Generate the secret with: openssl rand -base64 32
API_URL=http://localhost:8787
WEB_URL=http://localhost:3000
OAUTH_STATE_SECRET=

# Web app
NEXT_PUBLIC_SUPABASE_URL=${SUPABASE_URL}
NEXT_PUBLIC_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}
NEXT_PUBLIC_API_URL=http://localhost:8787
MS_AZURE_URL=https://login.microsoftonline.com/YOUR-TENANT-ID/v2.0
